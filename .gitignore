# Quarto build output and scratch
/_site/
/.quarto/

# Python / uv
/.venv/
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# NOTE: we intentionally do NOT ignore /_freeze/ — committing it lets the site
# rebuild without re-running Python (useful if you ever switch to CI).

*.quarto_ipynb*

# MSCI data: licensed, do not redistribute
msci_*.csv
msci_*.xls
msci_*.xlsx

.env

# Quarto project env file: machine-specific absolute PYTHONPATH (see the file's
# header). Kept out of the repo for the same reason as .env.
_environment
_environment.local


.claude/

**/*.quarto_ipynb

# Scratch notebooks (the _*.ipynb notebooks already committed stay tracked)
_*.ipynb

# Stray render output (the real output is _site/)
/posts/*/index.html
/posts/*/index_files/
/site_libs*/

# LaTeX by-products
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc

# Backups
*.bak*

# China figure: the pacing chart is written by china_figure.py's self-checks;
# the copy workbooks are working files of the apply_copy.py rewrite workflow.
posts/you-cant-bet-on-china/china_figure_pacing.png
posts/you-cant-bet-on-china/china_figure_copy.xlsx
posts/you-cant-bet-on-china/china_figure_copy.numbers
