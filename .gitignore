# Quarto build output and scratch
/_site/
/.quarto/

# Python / uv
/.venv/
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# NOTE: we intentionally do NOT ignore /_freeze/ — committing it lets the site
# rebuild without re-running Python (useful if you ever switch to CI).

*.quarto_ipynb*


.env

# Quarto project env file: machine-specific absolute PYTHONPATH (see the file's
# header). Kept out of the repo for the same reason as .env.
_environment
_environment.local


.claude/

**/*.quarto_ipynb
